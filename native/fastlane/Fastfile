# Builds Pep Prep and uploads it to TestFlight. Run by .github/workflows/ios-testflight.yml on a GitHub macOS machine.
# Signing is done for App Store/TestFlight distribution with the App Store Connect API key, so no registered device is needed.
default_platform(:ios)

BUNDLE_ID = "com.kingc4rl.pepprep"

platform :ios do
  lane :testflight_build do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      in_house: false
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key: ENV["ASC_KEY_P8"]
    )

    # A fresh build machine has no private key for older distribution certificates, so each run makes a new one.
    # Remove the ones earlier runs made so the account stays under Apple's limit (TestFlight builds already
    # uploaded keep working after their certificate is removed).
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      next unless %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type)
      UI.message("Removing old distribution certificate #{c.id} (#{c.display_name})")
      c.delete!
    end

    setup_ci # temporary keychain for this run
    cert(api_key: api_key, generate_apple_certs: true)
    sigh(api_key: api_key, app_identifier: BUNDLE_ID, force: true)

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      profile_uuid: lane_context[SharedValues::SIGH_UUID],
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => lane_context[SharedValues::SIGH_NAME] } },
      xcargs: "MARKETING_VERSION=#{ENV['APP_VERSION']} CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
      output_directory: "build",
      output_name: "PepPrep.ipa"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{ENV['BUILD_NUMBER']} to TestFlight. Apple takes 5-30 minutes to process it.")
  end
end
